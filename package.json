{
	"name": "@gnkz/oxlint-rules",
	"version": "0.1.0",
	"description": "Opinionated oxlint JS plugin: loose types, swallowed errors, narration comments and paragraph padding.",
	"keywords": [
		"lint",
		"oxlint",
		"oxlint-plugin",
		"typescript"
	],
	"homepage": "https://github.com/gnkz/oxlint-rules#readme",
	"bugs": "https://github.com/gnkz/oxlint-rules/issues",
	"license": "MIT",
	"author": "gnkz <gnkz.dev@gmail.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/gnkz/oxlint-rules.git"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./configs": {
			"types": "./dist/configs.d.ts",
			"default": "./dist/configs.js"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
		"prepublishOnly": "pnpm build",
		"changeset": "changeset"
	},
	"dependencies": {
		"@oxlint/plugins": "^1.87.0"
	},
	"devDependencies": {
		"@changesets/changelog-github": "^1.0.1",
		"@changesets/cli": "^3.0.3",
		"@types/node": "^24.19.1",
		"oxfmt": "0.72.0",
		"oxlint": "1.87.0",
		"oxlint-tsgolint": "7.0.2003",
		"typescript": "^7.0.2",
		"vitest": "^5.0.3"
	},
	"peerDependencies": {
		"oxlint": "^1.87.0"
	},
	"engines": {
		"node": "^20.19.0 || >=22.12.0"
	},
	"packageManager": "pnpm@12.9.1"
}
